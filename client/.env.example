# Adresse de l'API en production si elle est sur un AUTRE domaine (ex. https://api.mon-site.com).
# Laisser vide si Nginx sert le site et renvoie /api vers le serveur sur le même domaine.
VITE_API_URL=

# Développement : adresse du serveur Node lancé avec « npm run dev » dans server/
VITE_DEV_API=http://localhost:4000

# Google Tag Manager (chargé seulement après accord cookies)
VITE_GTM_ID=

# 1 = photos copiées dans public/images (voir « npm run images »)
VITE_LOCAL_IMAGES=
