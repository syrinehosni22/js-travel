# --- Serveur ---
PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/tunisia-tours
JWT_SECRET=change-moi-par-une-longue-chaine-aleatoire
# URL publique du site (liens dans e-mails, sitemap, hreflang)
SITE_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# --- Administrateur : créé AUTOMATIQUEMENT au démarrage du serveur s'il n'existe pas ---
ADMIN_EMAIL=salahjdeidi123@gmail.com
ADMIN_PASSWORD=admin123!
# true = réinitialise le mot de passe de ADMIN_EMAIL à chaque démarrage (mot de passe oublié). Remettre à false ensuite.
ADMIN_RESET=false
# true = si la base est vide, le serveur crée seul les données de démarrage (excursions, transferts, FAQ…) en 5 langues
AUTO_SEED=true

# --- E-mails (laisser vide : les e-mails s'affichent dans la console) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="JS Travel Tunisia <reservations@example.com>"
TEAM_EMAIL=equipe@example.com

# --- WhatsApp Cloud API (laisser vide : messages journalisés) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
TEAM_WHATSAPP=

# --- Anti-robots Cloudflare Turnstile (laisser vide en développement) ---
TURNSTILE_SECRET=

# --- Traduction automatique (saisie en français → en, de, it, es à l'enregistrement) ---
# Recommandé : clé DeepL API Free (gratuite, 500 000 caractères / mois) sur https://www.deepl.com/pro-api
DEEPL_API_KEY=
# Sans clé DeepL, service gratuit MyMemory (≈ 5 000 caractères / jour ; 50 000 avec un e-mail ci-dessous)
MYMEMORY_EMAIL=
# off = désactiver la traduction automatique
TRANSLATE_PROVIDER=
TRANSLATE_SOURCE=fr

# --- Taux de change (open.er-api.com, gratuit, sans clé). auto | manual ---
FX_MODE=auto
